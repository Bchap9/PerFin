# Build context for deploy/Dockerfile (context = repository root).
# Allowlist: everything is excluded unless re-included below, so env files,
# keys, user data, git history and local virtualenvs can never reach an image
# layer (SECURITY.md H5).
*

!backend/pyproject.toml
!backend/uv.lock
!backend/README.md
!backend/alembic.ini
!backend/app/
!backend/migrations/

!frontend/
frontend/node_modules/
frontend/dist/
frontend/coverage/
frontend/.vite/

# Never, even inside an allowlisted directory.
**/__pycache__/
**/*.py[cod]
**/.env
**/.env.*
**/*.pem
**/*.key
**/.DS_Store
