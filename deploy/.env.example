# SPDX-License-Identifier: AGPL-3.0-or-later
# ---- PerFin configuration --------------------------------------------------
#
#   cp .env.example .env && chmod 600 .env    # never commit .env
#
# Every value marked CHANGE_ME must be replaced; `perfin config check` and the
# database init script refuse to start with a placeholder. Generate secrets on
# the host, for example:
#
#   openssl rand -hex 32        URL-safe password (database passwords)
#   openssl rand -base64 32     PERFIN_MASTER_KEY (exactly 32 random bytes)
#   openssl rand -base64 48     PERFIN_SECRET_KEY
#
# Compose reads this file twice: for ${...} interpolation in
# docker-compose.yml, and as the environment of the api, worker and migrate
# containers. docker-compose.yml blanks, per service, every secret a service
# does not need (the superuser and owner passwords never reach api/worker;
# the master key never reaches migrate; the mcp container does not read this
# file at all). backend/tests/unit/test_compose_hardening.py enforces that.

# ---- Image -------------------------------------------------------------------
# Pin a release tag in production instead of "latest" so updates are deliberate.
PERFIN_VERSION=latest
# APP_IMAGE=ghcr.io/bchap9/perfin

# ---- Instance ----------------------------------------------------------------
PERFIN_PUBLIC_URL=https://perfin.example.com
# Set per container by docker-compose.yml (api | worker | mcp).
# PERFIN_ROLE=api
# The image listens on 0.0.0.0:8000 inside its private network; only the
# proxy can reach it. Outside containers the default is 127.0.0.1.
# PERFIN_BIND_HOST=0.0.0.0
# PERFIN_BIND_PORT=8000

# ---- Secrets -----------------------------------------------------------------
# 32 random bytes, base64. Generate: openssl rand -base64 32
# Back this up SEPARATELY from the database and documents. Losing it loses
# every document. Instead of the variable you may mount a file (mode 0400,
# owned by UID 10001) and set PERFIN_MASTER_KEY_FILE; set only one of the two.
PERFIN_MASTER_KEY=CHANGE_ME
# PERFIN_MASTER_KEY_FILE=/run/secrets/perfin_master_key

# Set true once the master key is backed up somewhere other than the
# database/document backups (password manager, offline copy). Until then
# every start logs a key-backup warning (SECURITY.md G4).
PERFIN_MASTER_KEY_BACKUP_ACKNOWLEDGED=false

# Random secret for CSRF/session signing. Generate: openssl rand -base64 48
PERFIN_SECRET_KEY=CHANGE_ME

# ---- Database ----------------------------------------------------------------
# Three distinct passwords, each from: openssl rand -hex 32
# (hex keeps them safe inside the URLs below). They are read once, when the
# database volume is first initialised (deploy/db-init); changing them later
# needs ALTER ROLE inside the database as well.
#
# Bootstrap superuser: used only by the db container and its init scripts.
POSTGRES_PASSWORD=CHANGE_ME
# perfin_owner: owns the schema, used only by the one-shot `migrate` service.
POSTGRES_OWNER_PASSWORD=CHANGE_ME
# perfin_app: no superuser, no BYPASSRLS, owns nothing; api and worker.
POSTGRES_APP_PASSWORD=CHANGE_ME

# Application connection (RLS applies). Used by api and worker.
PERFIN_DATABASE_URL=postgresql+psycopg://perfin_app:${POSTGRES_APP_PASSWORD}@db:5432/perfin
# Migration connection (owner role). Given only to the `migrate` service.
PERFIN_MIGRATION_DATABASE_URL=postgresql+psycopg://perfin_owner:${POSTGRES_OWNER_PASSWORD}@db:5432/perfin
# Role the migrations grant DML to; must match the role in PERFIN_DATABASE_URL.
PERFIN_DB_APP_ROLE=perfin_app
# Per-statement and lock-wait limits in milliseconds (SECURITY.md F8).
PERFIN_DB_STATEMENT_TIMEOUT_MS=30000
PERFIN_DB_LOCK_TIMEOUT_MS=10000

# ---- Network -----------------------------------------------------------------
# Trust X-Forwarded-* only from the reverse proxy. docker-compose.yml pins the
# proxy to this address on the private `web` network (WEB_SUBNET, PROXY_WEB_IP).
PERFIN_TRUSTED_PROXIES=172.30.80.10/32
# WEB_SUBNET=172.30.80.0/24
# PROXY_WEB_IP=172.30.80.10
# Host ports the proxy publishes (the only published ports).
# PROXY_HTTP_PORT=80
# PROXY_HTTPS_PORT=443

# CSP require-trusted-types-for 'script' (SECURITY.md F1). Leave on; false
# is only a temporary escape hatch if a frontend dependency trips it.
PERFIN_CSP_TRUSTED_TYPES=true

# Built web UI served by the API (frontend/dist). The image sets /app/static;
# leave unset here unless you mount a different build.
# PERFIN_STATIC_DIR=/app/static

# ---- Sessions ----------------------------------------------------------------
PERFIN_SESSION_IDLE_MINUTES=30
PERFIN_SESSION_ABSOLUTE_HOURS=12
# "Remember this device" sessions live this many days (step-up still needs MFA).
PERFIN_SESSION_REMEMBER_DAYS=30
PERFIN_REQUIRE_MFA=true
# Longest expiry (days) a personal access token may be created with (1..365).
PERFIN_TOKEN_MAX_DAYS=90
# Secure cookies (Secure flag, __Host- prefix). Only PERFIN_DEV_MODE may turn
# this off; `perfin config check` refuses false in production.
PERFIN_SECURE_COOKIES=true

# ---- Local login / break-glass -------------------------------------------------
# Set false for OIDC-only mode. Break-glass admin stays reachable from
# PERFIN_BREAKGLASS_CIDRS only (checked at login and on every request).
# In Compose, clients on the Docker host itself (for example an SSH tunnel)
# reach PerFin from the edge network's gateway, EDGE_GATEWAY below, not from
# 127.0.0.1, so the default matches nothing and break-glass login stays closed
# until you set PERFIN_BREAKGLASS_CIDRS=172.30.79.1/32 deliberately. Read the
# IPv6 caveat in docs/AUTHENTIK.md (step 9a) first: Docker's userland proxy
# forwards IPv6 clients from that same gateway address.
PERFIN_LOCAL_LOGIN_ENABLED=true
PERFIN_BREAKGLASS_CIDRS=127.0.0.1/32
# EDGE_SUBNET=172.30.79.0/24
# EDGE_GATEWAY=172.30.79.1
# OIDC-only mode (PERFIN_LOCAL_LOGIN_ENABLED=false) refuses to start until this
# names the break-glass local admin account you created.
# PERFIN_BREAKGLASS_ADMIN_USERNAME=
# Check new passwords against Have I Been Pwned as well as the bundled
# breached-password list (k-anonymity range query, an off-host call that needs
# egress to api.pwnedpasswords.com). Off by default.
PERFIN_HIBP_CHECK_ENABLED=false
# The one-time setup URL is logged at WARNING and written here (mode 0600)
# while no user exists; `perfin bootstrap-url` prints a fresh one.
# PERFIN_BOOTSTRAP_URL_FILE=/var/lib/perfin/documents/.perfin-setup/setup-url

# ---- SMTP (password reset) -----------------------------------------------------
# Password reset by email is offered only when host and from address are set
# (and local login is enabled). TLS is required: starttls (port 587) or
# implicit (port 465); certificates are verified.
# PERFIN_SMTP_HOST=smtp.example.com
# PERFIN_SMTP_PORT=587
# PERFIN_SMTP_TLS=starttls
# PERFIN_SMTP_USERNAME=
# PERFIN_SMTP_PASSWORD=
# PERFIN_SMTP_FROM=perfin@example.com
# PERFIN_SMTP_TIMEOUT_SECONDS=10

# ---- OIDC (Authentik) ----------------------------------------------------------
# Leave PERFIN_OIDC_ISSUER empty to disable.
PERFIN_OIDC_ISSUER=
# PERFIN_OIDC_ISSUER=https://auth.example.com/application/o/perfin/
PERFIN_OIDC_CLIENT_ID=
# From the IdP's application page; never reaches the migrate or mcp containers.
PERFIN_OIDC_CLIENT_SECRET=
PERFIN_OIDC_SCOPES=openid profile email groups
PERFIN_OIDC_JIT_PROVISIONING=false
PERFIN_OIDC_GROUP_ADMIN=perfin-admins
PERFIN_OIDC_GROUP_MEMBER=perfin-users
PERFIN_OIDC_GROUP_VIEWER=perfin-viewers
PERFIN_OIDC_REQUIRE_GROUP=true
# Set true only if Authentik is on a private address (home LAN).
PERFIN_OIDC_ALLOW_PRIVATE_ISSUER=false
# Accept the IdP's amr claim (mfa, or two kinds of factor) as PerFin MFA.
# Enable only when the IdP enforces MFA for this application.
PERFIN_OIDC_TRUST_IDP_MFA=false
# Token endpoint client authentication: client_secret_basic (the secret above)
# or private_key_jwt (PEM private key, RSA >= 2048 or EC P-256, mode 0400).
# PERFIN_OIDC_TOKEN_AUTH_METHOD=client_secret_basic
# PERFIN_OIDC_PRIVATE_KEY_FILE=/run/secrets/perfin_oidc_key.pem
# PERFIN_OIDC_PRIVATE_KEY_ID=
# Offer to link an IdP login to the local account with the same verified email
# (the user must log in locally, with MFA if enrolled, to confirm).
PERFIN_OIDC_LINK_BY_VERIFIED_EMAIL=false
# Household that group-mapped roles apply to (default: the only household).
# PERFIN_OIDC_HOUSEHOLD_ID=
# Comma-separated allowlist for post_logout_redirect_uri (default: PERFIN_PUBLIC_URL/).
# PERFIN_OIDC_POST_LOGOUT_REDIRECT_URIS=https://perfin.example.com/
# Re-check claims (groups, account still enabled) with the refresh token every
# N minutes; 0 = off (no refresh token is stored).
PERFIN_OIDC_CLAIM_REFRESH_MINUTES=0
# JWKS refetch on an unknown key id at most this often; cache lifetime cap.
# PERFIN_OIDC_JWKS_MIN_REFRESH_SECONDS=300
# PERFIN_OIDC_METADATA_MAX_AGE_SECONDS=3600
# PERFIN_OIDC_HTTP_TIMEOUT_SECONDS=10

# ---- Intake --------------------------------------------------------------------
# Keep in step with the upload body limit in the Caddyfile (+2 MB headroom).
PERFIN_UPLOAD_MAX_MB=50
# Host directories for the drop folder (docker-compose.yml bind mounts). The
# inbox is mounted read-only into the worker; processed/ is its writable
# sibling. Create both and make processed/ writable by UID 10001:
#   mkdir -p inbox processed && sudo chown 10001:10001 processed
DROPFOLDER_HOST_INBOX=./inbox
DROPFOLDER_HOST_PROCESSED=./processed
# Paths inside the worker container (set by the image; change only together
# with the mounts in docker-compose.yml).
PERFIN_DROPFOLDER_INBOX=/var/lib/perfin/inbox
PERFIN_DROPFOLDER_PROCESSED=/var/lib/perfin/processed
# The worker watches the inbox (inotify, polling fallback) and copies settled
# files into quarantine. Files go to the only household unless
# PERFIN_DROPFOLDER_HOUSEHOLD_ID names one (required with several).
# inbox/<member>/<account>/file maps to a member (by username) and one of
# their accounts (by name); anything else asks "Who does this belong to?".
PERFIN_DROPFOLDER_ENABLED=true
# PERFIN_DROPFOLDER_HOUSEHOLD_ID=
# A file is taken once unchanged this long (and, with the sidecar option,
# only when <name>.ready exists next to it).
PERFIN_DROPFOLDER_SETTLE_SECONDS=10
PERFIN_DROPFOLDER_READY_SIDECAR=false
# keep | move | delete. With the read-only inbox above only keep works:
# taken files are remembered (path, size, mtime, hash) and never taken
# twice. move (into processed/, refused files into processed/failed/) and
# delete need the inbox mounted read-write: drop ":ro" from its mount in
# docker-compose.yml, accepting that the worker can then change it.
PERFIN_DROPFOLDER_AFTER=keep
# PERFIN_DROPFOLDER_FAILED=/var/lib/perfin/processed/failed
# Per-run caps (one run a minute): files and megabytes taken.
PERFIN_DROPFOLDER_MAX_FILES_PER_RUN=100
PERFIN_DROPFOLDER_MAX_MB_PER_RUN=1024
PERFIN_DROPFOLDER_WATCH_SECONDS=45

# Email intake (optional; credentials are stored encrypted in the DB via the
# settings UI, not here). Needs the `egress` profile and the IMAP host in
# egress-allowlist.txt.
PERFIN_EMAIL_INTAKE_ENABLED=false
# Each household's owner or admin sets host, app password and folders under
# Settings; the worker polls every 5 minutes over IMAPS (port 993, verified
# certificate; a private CA via SSL_CERT_FILE). Per-run caps:
PERFIN_EMAIL_INTAKE_MAX_MESSAGES_PER_RUN=50
PERFIN_EMAIL_INTAKE_MAX_MB_PER_RUN=200
PERFIN_EMAIL_INTAKE_MAX_MESSAGE_MB=25
PERFIN_EMAIL_INTAKE_TIMEOUT_SECONDS=30
# Without a proxy, private (LAN) IMAP server addresses are refused unless:
PERFIN_EMAIL_INTAKE_ALLOW_PRIVATE_HOSTS=false

# ---- Document store and extraction sandbox ---------------------------------------
# Encrypted document blobs and the quarantine area (paths inside the
# containers; change only together with the volumes in docker-compose.yml).
PERFIN_DOCUMENTS_DIR=/var/lib/perfin/documents
PERFIN_QUARANTINE_DIR=/var/lib/perfin/quarantine
# Limits of the sandboxed extraction subprocess (ADR-0006): address space,
# CPU time, wall-clock time (at most 600) and result size.
PERFIN_EXTRACT_MEMORY_MB=1024
PERFIN_EXTRACT_CPU_SECONDS=60
PERFIN_EXTRACT_TIMEOUT_SECONDS=120
PERFIN_EXTRACT_MAX_OUTPUT_MB=64
# Only when the worker runs as root (not the shipped image, which runs as
# 10001): the UID/GID the extraction child switches to.
# PERFIN_EXTRACT_UID=
# The extraction child confines itself with Landlock and refuses to run on a
# kernel without it (SECURITY.md C1, ADR-0009). Set to false only if the host
# kernel has no Landlock: seccomp and the worker's non-dumpable flag are then
# the only isolation between a parser exploit and the worker's files.
PERFIN_EXTRACT_REQUIRE_LANDLOCK=true
# Statement/payslip fields parsed with less confidence than this (0.5-1.0)
# are imported pending, with a review item (docs/INGESTION.md "Commit").
PERFIN_INGEST_CONFIDENCE_THRESHOLD=0.85

# ---- Full export and import (docs/PORTABILITY.md) -------------------------------
# A finished export can be downloaded once within this many minutes (5-1440);
# then its encrypted archive is destroyed. POST /import accepts archives up to
# this size; the worker holds one in memory while validating it.
PERFIN_EXPORT_TTL_MINUTES=60
PERFIN_IMPORT_MAX_MB=512

# ---- Live updates (Server-Sent Events, GET /api/v1/events) -----------------------
# Keep-alive comment interval, stream lifetime (the browser reconnects with
# Last-Event-ID), how often a stream re-checks its session and grants, and
# concurrent streams per user per API process. Each stream holds one database
# connection: keep max streams x expected users within max_connections.
PERFIN_SSE_HEARTBEAT_SECONDS=15
PERFIN_SSE_MAX_STREAM_SECONDS=600
PERFIN_SSE_REVALIDATE_SECONDS=30
PERFIN_SSE_MAX_STREAMS_PER_USER=5

# ---- Integrations (all default off) --------------------------------------------
PERFIN_PRICE_PROVIDER=none
# none | clamav (needs the `av` profile: docker compose --profile av up -d).
# Every received document is scanned before extraction; a positive result is
# `rejected` with the signature name recorded (SECURITY.md C9).
PERFIN_ANTIVIRUS=none
# clamd address on the internal network (tcp://host:port or unix:///path),
# per-operation timeout, largest document sent (keep clamd's StreamMaxLength
# at least this), and what happens when a scan cannot run: closed (retry, then
# fail the document) or open (go on unscanned; not recommended).
PERFIN_CLAMAV_ADDRESS=tcp://clamav:3310
PERFIN_CLAMAV_TIMEOUT_SECONDS=30
PERFIN_CLAMAV_MAX_MB=50
PERFIN_ANTIVIRUS_FAIL_MODE=closed

# ---- Egress (optional `egress` profile) ----------------------------------------
# The worker has no route to the internet. To let it reach the hosts listed in
# egress-allowlist.txt (IMAPS, price feeds), start the `egress` profile and
# uncomment these so outbound HTTPS/IMAPS tunnels go through the proxy.
# HTTPS_PROXY=http://egress:3128
# NO_PROXY=localhost,127.0.0.1,db,api,clamav
# Private ranges the egress proxy may reach (an IMAP server on the home LAN).
# EGRESS_ALLOW_PRIVATE_CIDRS=192.168.1.0/24

# ---- AI access (MCP role, optional `mcp` profile) -------------------------------
# PerFin never calls a model itself. The mcp container receives only the
# variables listed for it in docker-compose.yml: no database URL, master key
# or secret key (AI_ACCESS.md M7).
PERFIN_MCP_ENABLED=false
# stdio | http
PERFIN_MCP_TRANSPORT=stdio
# Required (explicit origins, no *) when PERFIN_MCP_TRANSPORT=http.
PERFIN_MCP_HTTP_ALLOWED_ORIGINS=

# ---- Observability -------------------------------------------------------------
# DEBUG is refused by `perfin config check` outside PERFIN_DEV_MODE.
PERFIN_LOG_LEVEL=INFO
# internal network only, never published
PERFIN_METRICS_PORT=9100
# Loopback by default: the proxy and mcp containers must not reach metrics.
# To scrape with Prometheus, set the container's backend-network address.
PERFIN_METRICS_BIND_HOST=127.0.0.1

# Never set outside local development. Disables secure-cookie and HTTPS checks.
PERFIN_DEV_MODE=false
