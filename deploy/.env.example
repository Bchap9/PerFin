# ---- PerFin configuration (copy to .env; never commit .env) ----------------

PERFIN_VERSION=latest
PERFIN_PUBLIC_URL=https://perfin.example.com

# 32 random bytes, base64. Generate: openssl rand -base64 32
# Back this up SEPARATELY from the database and documents. Losing it loses
# every document. Prefer PERFIN_MASTER_KEY_FILE pointing at a mounted secret.
PERFIN_MASTER_KEY=CHANGE_ME
# PERFIN_MASTER_KEY_FILE=/run/secrets/perfin_master_key

# Random secret for CSRF/session signing. Generate: openssl rand -base64 48
PERFIN_SECRET_KEY=CHANGE_ME

# Database
POSTGRES_PASSWORD=CHANGE_ME
PERFIN_DATABASE_URL=postgresql+psycopg://perfin:${POSTGRES_PASSWORD}@db:5432/perfin

# Trust X-Forwarded-* headers only from these CIDRs (the proxy network).
PERFIN_TRUSTED_PROXIES=172.16.0.0/12

# Sessions
PERFIN_SESSION_IDLE_MINUTES=30
PERFIN_SESSION_ABSOLUTE_HOURS=12
PERFIN_REQUIRE_MFA=true

# Local login: set false for OIDC-only mode. Break-glass admin stays
# reachable from PERFIN_BREAKGLASS_CIDRS only.
PERFIN_LOCAL_LOGIN_ENABLED=true
PERFIN_BREAKGLASS_CIDRS=127.0.0.1/32

# OIDC (Authentik). Leave PERFIN_OIDC_ISSUER empty to disable.
PERFIN_OIDC_ISSUER=https://auth.example.com/application/o/perfin/
PERFIN_OIDC_CLIENT_ID=
PERFIN_OIDC_CLIENT_SECRET=
PERFIN_OIDC_SCOPES=openid profile email groups
PERFIN_OIDC_JIT_PROVISIONING=false
PERFIN_OIDC_GROUP_ADMIN=perfin-admins
PERFIN_OIDC_GROUP_MEMBER=perfin-users
PERFIN_OIDC_GROUP_VIEWER=perfin-viewers
PERFIN_OIDC_REQUIRE_GROUP=true
# Set true only if Authentik is on a private address (home LAN).
PERFIN_OIDC_ALLOW_PRIVATE_ISSUER=false

# Intake
PERFIN_UPLOAD_MAX_MB=50
PERFIN_DROPFOLDER_INBOX=./inbox
PERFIN_DROPFOLDER_PROCESSED=./processed
PERFIN_DROPFOLDER_SETTLE_SECONDS=10
PERFIN_DROPFOLDER_AFTER=move          # move | delete | keep

# Email intake (optional; credentials are stored encrypted in the DB via the
# settings UI, not here). Set the IMAP host to enable egress for it.
PERFIN_EMAIL_INTAKE_ENABLED=false

# Integrations (all default off)
PERFIN_PRICE_PROVIDER=none
PERFIN_ANTIVIRUS=none                 # none | clamav

# AI access (MCP role, optional). PerFin never calls a model itself.
PERFIN_MCP_ENABLED=false
PERFIN_MCP_TRANSPORT=stdio            # stdio | http
PERFIN_MCP_HTTP_ALLOWED_ORIGINS=
# Hostnames allowed as "on-prem" model endpoints for Tier 2 clients, in
# addition to private address ranges.
PERFIN_MCP_ONPREM_HOSTS=

# Observability
PERFIN_LOG_LEVEL=INFO
PERFIN_METRICS_PORT=9100              # internal only, never published

# Never set outside local development. Disables secure-cookie and HTTPS checks.
PERFIN_DEV_MODE=false
